# magpie.service — the orchestrator (webhook server, queue, git ops, rootless
# podman reviewer runner, publisher). Milestone 5 (task_56ad); converted to the
# ROOTLESS-PODMAN + micro-VM substrate in Milestone 8 (M8-D3, task_67aa).
#
# Runs as a dedicated unprivileged `magpie` user. As of M8-B2/M8-D3 the reviewer
# is launched with ROOTLESS podman (no root daemon, no `docker` group) — see
# packages/orchestrator/src/reviewer.ts and docs/design/cto-decision-brief.md §5.
# The orchestrator therefore no longer needs ANY privileged group: rootless
# podman relies only on the `magpie` user's subuid/subgid ranges + a lingering
# per-user systemd session (both provisioned by scripts/install.sh). It never
# holds the real OpenRouter key (it mints a short-lived per-job virtual key from
# the gateway instead, M4-C); only the webhook secret + GitHub App key live in
# its environment / config.
#
# ============================================================================
# WHY THE HARDENING PROFILE IS DELIBERATELY LIGHTER THAN THE GATEWAY'S
# ============================================================================
# This unit's sandbox is INTENTIONALLY relaxed relative to magpie-gateway.service
# and relative to this unit's own pre-M8 (rootful-docker) form. That is not an
# oversight — it is inherent to the CTO-approved rootless design (brief §5): the
# review CONTAINER / micro-VM is the security boundary around untrusted PR
# content, and the orchestrator is TRUSTED host code whose job is to CREATE the
# user/mount/pid/... namespaces that launch that sandbox rootlessly. Two
# structural facts force the relaxations, both proven empirically on the M8-D3
# target (arm64, 16 KB pages, podman 4.3.1):
#
#   1. Rootless podman maps the container's uid range with the setuid-root
#      helpers newuidmap/newgidmap (the ONLY setuid surface in the whole
#      rootless design — brief §5's TCB claim). Those helpers can only elevate
#      when NO_NEW_PRIVS is UNSET. Every seccomp-based systemd directive
#      (SystemCallFilter, RestrictAddressFamilies, RestrictSUIDSGID,
#      LockPersonality, RestrictRealtime, ProtectClock, ProtectHostname,
#      ProtectKernelTunables/Modules/Logs) forces NO_NEW_PRIVS=1, which makes
#      newuidmap fail with "write to uid_map failed: Operation not permitted"
#      and breaks EVERY review launch. They are therefore removed (see the
#      per-directive notes below). RestrictNamespaces is the ONE seccomp-style
#      directive systemd applies WITHOUT forcing NO_NEW_PRIVS, so it is KEPT
#      (relaxed to an explicit allow-list — see below).
#
#   2. The per-review `--memory` cap is only ENFORCED when the container cgroup
#      is created under a cgroup subtree that has the memory controller
#      delegated. For rootless podman that subtree is the invoking user's
#      `user@<uid>.service` (which `loginctl enable-linger` starts, and which
#      systemd already delegates memory/cpu/pids to) — NOT this system unit's
#      own cgroup. podman reaches it via XDG_RUNTIME_DIR + DBUS_SESSION_BUS_ADDRESS
#      below. This is EXACTLY the topology cgroup-preflight.ts documents in its
#      "TOPOLOGY CAVEAT" ("the container cgroup lands under the invoking user's
#      slice, and the shipped magpie.service runs as a system unit … no
#      Delegate="). Consequences, both verified on-target:
#        * ProtectHome=true makes /run/user/ inaccessible, so podman cannot
#          reach the user-session bus and the memory cap silently no-ops —
#          REMOVED.
#        * Delegate=yes on THIS unit makes crun try to create the container
#          scope under system.slice via a user manager that owns a different
#          subtree; it fails ("creating systemd unit …scope: got failed") and
#          every review launch dies. So Delegate is deliberately NOT set here —
#          the delegation that makes `--memory` real lives on user@<uid>.service
#          (linger), not on this unit. The reviewer container itself re-asserts
#          the enforced ceiling fail-closed per job (docker/reviewer/entrypoint.sh).
#
# The untrusted-content confinement that these host-side directives used to add
# is NOT lost: it now lives on the `podman run` argv (--cap-drop=ALL,
# --security-opt=no-new-privileges, --read-only, --pids-limit, --network none,
# seccomp default) and, at the strongest tier, in the KVM micro-VM guest
# boundary — see reviewer.ts and the isolation ladder (tier-ladder.ts).
#
# Ordering: started AFTER the gateway (so a webhook arriving right after boot
# can immediately mint a virtual key). There is no docker.service / firewall
# unit to order after any more — rootless podman has no daemon, and M7-1's
# Design D runs each review container `--network none` (no bridge/iptables to
# provision). On stop it must DRAIN in-flight jobs rather than be killed
# mid-review — the SIGTERM graceful-shutdown path already exists
# (packages/orchestrator/src/index.ts + shutdown.ts); TimeoutStopSec below is
# sized to let that drain finish.
#
# Config: MAGPIE_CONFIG=/etc/magpie/config.toml is set in the EnvironmentFile so
# the loader finds it regardless of WorkingDirectory. Secrets
# (MAGPIE_WEBHOOK_SECRET, MAGPIE_GATEWAY_MASTER_KEY) come from
# /etc/magpie/magpie.env (chmod 600, owned by magpie) — see scripts/install.sh.
#
# NOTE ON PLACEHOLDERS: scripts/install.sh rewrites `MAGPIE_RUNTIME_UID` below
# to the numeric uid of the `magpie` user at install time (systemd's `%U`
# specifier resolves to the MANAGER uid, not User=, on systemd 252, so it cannot
# be used here). The authored value is a harmless opaque string until rewritten.

[Unit]
Description=magpie orchestrator (GitHub PR review bot)
Documentation=file:/opt/magpie/PLAN.md
# No Requires=/After=docker.service any more: the reviewer runs under ROOTLESS
# podman, which has no root daemon to depend on (M8-B2/M8-D3).
After=network-online.target magpie-gateway.service
Wants=network-online.target magpie-gateway.service

[Service]
Type=simple
User=magpie
Group=magpie
# No SupplementaryGroups=docker any more (rootless podman needs no docker group).
# /dev/kvm for the micro-VM tier is reached via the `kvm` GROUP, which
# scripts/install.sh adds `magpie` to (usermod -aG kvm) — systemd automatically
# includes the User='s database supplementary groups, so no SupplementaryGroups=
# line is needed (and hardcoding `kvm` here would fail the unit on crun-floor
# hosts that have no kvm group). The crun floor needs no /dev/kvm at all.
WorkingDirectory=/opt/magpie
EnvironmentFile=/etc/magpie/magpie.env
# Rootless-podman runtime environment:
#   HOME             — podman's per-user storage (graphRoot) lives at
#                      $HOME/.local/share/containers; point it at the writable
#                      StateDirectory (/var/lib/magpie) rather than the account's
#                      real home (which ProtectSystem=strict would keep read-only).
#   XDG_RUNTIME_DIR  — the lingering user session's runtime dir; podman uses it
#                      for its runRoot and, crucially, to reach the user systemd
#                      manager that enforces the `--memory` cap (see the header).
#   DBUS_SESSION_BUS_ADDRESS — the user manager's bus; without it podman falls
#                      back to cgroupfs and the memory cap is NOT enforced as a
#                      finite ceiling. `MAGPIE_RUNTIME_UID` is rewritten to the
#                      magpie uid by scripts/install.sh (see header note).
Environment=HOME=/var/lib/magpie
Environment=XDG_RUNTIME_DIR=/run/user/MAGPIE_RUNTIME_UID
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/MAGPIE_RUNTIME_UID/bus
ExecStart=/usr/bin/node /opt/magpie/packages/orchestrator/dist/index.js
Restart=on-failure
RestartSec=5s

# Graceful drain on stop: the shutdown handler stops accepting webhooks, then
# drains queued/running jobs so each job's cleanup runs (workspace removal,
# container kill, virtual-key revoke) instead of being cut off. The drain is
# bounded by the queue's own per-job timeout, so give systemd headroom past
# limits.job_timeout_seconds (default 600s) before it escalates to SIGKILL.
# Keep this GREATER THAN config.toml's limits.job_timeout_seconds.
KillSignal=SIGTERM
TimeoutStopSec=660s

# --- systemd hardening (rootless-compatible subset — see the header) ---------
# Creates/owns /var/lib/magpie (0750) and adds it to the writable set — this is
# where PR checkouts (workspace.work_dir = /var/lib/magpie/work) AND rootless
# podman's own image/container storage ($HOME/.local/share/containers) live.
# Nothing else on the root filesystem is writable.
StateDirectory=magpie
StateDirectoryMode=0750
# ProtectSystem=strict: whole root fs read-only except StateDirectory (and the
# separately-mounted /run/user/<uid> tmpfs, which keeps its own rw options).
# KEPT — proven compatible with rootless podman on-target.
ProtectSystem=strict
# PrivateTmp=true: private /tmp + /var/tmp. KEPT — compatible.
PrivateTmp=true
# RestrictNamespaces RELAXED from `true` (deny-all) to an explicit ALLOW-LIST of
# exactly the namespace types rootless podman + crun (+ libkrun at the micro-VM
# tier) must create to launch the sandbox: user (the whole rootless premise),
# mnt/pid/ipc/uts/net (container isolation), cgroup (per-container cgroup ns).
# `true` blocked CLONE_NEWUSER and broke every rootless launch. This is the one
# seccomp-style directive systemd applies WITHOUT forcing NO_NEW_PRIVS, so —
# unlike the removed directives below — it does not break newuidmap. Only
# CLONE_NEWTIME is omitted (unused). The orchestrator creating these namespaces
# is expected: it is the launcher of the sandbox, not the sandboxed party.
RestrictNamespaces=cgroup ipc net mnt pid user uts
# No ambient capabilities are granted to the orchestrator process itself. The
# CapabilityBoundingSet is deliberately NOT emptied: the setuid-root
# newuidmap/newgidmap helpers rootless podman execs need the default bounding
# set to write the uid/gid maps, and the magpie process is non-root so holds no
# capability regardless of the bounding set. (Emptying it reproduces the
# newuidmap "open of uid_map: Permission denied" failure.)
AmbientCapabilities=
# NoNewPrivileges is intentionally left UNSET (i.e. false): setting it true —
# or adding any of the seccomp-based directives below that imply it — blocks the
# setuid newuidmap/newgidmap elevation and breaks every rootless review launch.
# See the header for the full rationale.
#
# REMOVED for rootless compatibility (each would force NO_NEW_PRIVS=1 and break
# newuidmap, verified on-target), with the confinement they used to provide now
# living on the `podman run` argv / micro-VM guest instead:
#   ProtectHome=true          — ALSO hides /run/user, breaking memory-cap enforcement (see header).
#   ProtectKernelTunables=true / ProtectKernelModules=true / ProtectKernelLogs=true
#   ProtectControlGroups=true — remounts /sys/fs/cgroup ro; interferes with the rootless cgroup path.
#   ProtectClock=true / ProtectHostname=true
#   RestrictRealtime=true / RestrictSUIDSGID=true / LockPersonality=true
#   RestrictAddressFamilies=… — would have GAINED AF_VSOCK for the micro-VM
#       tier's host↔guest channel, but the directive as a whole forces
#       NO_NEW_PRIVS and breaks newuidmap, so it is dropped ENTIRELY; AF_VSOCK
#       (and every other family the launcher/forwarder use) is consequently
#       unrestricted. The vsock channel is instead confined by the guest-side
#       fail-closed assertions (docker/reviewer/entrypoint.sh) and the per-job
#       socket path, per brief §5.
#   SystemCallFilter=@system-service / SystemCallErrorNumber / SystemCallArchitectures
# Delegate=yes is deliberately NOT set (it breaks the rootless cgroup scope —
# see the header); /dev/kvm needs no DeviceAllow because DevicePolicy stays
# `auto` (no PrivateDevices), so kvm-group access to /dev/kvm is unhindered.
# NOTE: deliberately NO MemoryDenyWriteExecute — V8's JIT needs W^X memory.

[Install]
WantedBy=multi-user.target
